# Kafka (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
# Dev y prod comparten el mismo cluster de Confluent Cloud -- en local usa
# SIEMPRE un sufijo distinto (ej. "-local") para no unirte al mismo grupo
# de consumidores que producción.
KAFKA_GROUP_ID=inventory-service-group-local

REDIS_URL=redis://user:password@host:port

# catalog-service URL
# Local (Docker):      http://catalog-service:8006
# Producción (Render): https://catalog-service-cinema.onrender.com
CATALOG_SERVICE_URL=

PYTHON_VERSION=3.12
